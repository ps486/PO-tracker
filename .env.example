# Database
DATABASE_URL=postgresql+psycopg2://po_tracker:po_tracker@localhost:5432/po_tracker

# Security
SECRET_KEY=change-me-to-a-random-64-char-value
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Gmail OAuth (from Google Cloud Console -> APIs & Services -> Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/auth/gmail/callback
GMAIL_QUERY=label:po-tracker newer_than:7d
GMAIL_POLL_INTERVAL_SECONDS=300

# AI extraction
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5

# Thresholds (0-1)
CLASSIFICATION_CONFIDENCE_THRESHOLD=0.85
MATCHING_CONFIDENCE_THRESHOLD=0.90
FIELD_CONFIDENCE_THRESHOLD=0.80

# Storage
ATTACHMENT_STORAGE_DIR=./data/attachments

# Environment
ENVIRONMENT=development
